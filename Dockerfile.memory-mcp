# memory-mcp: containerized memory MCP server (ONNX embeddings, Linux).
# Build context = ~/repos/memory (the memory package source).
FROM python:3.12-slim

# MEMORY_DATA_DIR holds the baked model (image layer, must NOT be under the
# /data volume or the mount would mask it). MEMORY_DB puts only the SQLite file
# on the volume — see paths.py, which resolves the two independently.
ENV HOME=/opt/memstack \
    MEMORY_DATA_DIR=/opt/memstack/data \
    MEMORY_DB=/data/sqlite_vec.db \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# onnxruntime needs libgomp; curl/ca-certs to bake the embedding model.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgomp1 curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/memstack/app
COPY . /opt/memstack/app

# Install the memory package (mlx markers are darwin-only -> skipped on linux,
# so onnxruntime path is used) plus the stdio->SSE bridge.
RUN pip install . && pip install mcp-proxy

# Bake the ONNX embedding model + tokenizer so first boot needs no network.
# MODEL_DIR is <MEMORY_DATA_DIR>/models (see embeddings.py, which calls data_dir()).
RUN mkdir -p /opt/memstack/data/models/modernbert-embed-base/onnx \
 && curl -fSL https://huggingface.co/nomic-ai/modernbert-embed-base/resolve/main/onnx/model_uint8.onnx \
      -o /opt/memstack/data/models/modernbert-embed-base/onnx/model_uint8.onnx \
 && curl -fSL https://huggingface.co/nomic-ai/modernbert-embed-base/resolve/main/tokenizer.json \
      -o /opt/memstack/data/models/modernbert-embed-base/tokenizer.json

# /data holds only the shared SQLite DB (mounted volume). The rerank cache lives
# in MEMORY_DATA_DIR and is therefore ephemeral — it rebuilds on demand.
RUN mkdir -p /data
VOLUME ["/data"]

EXPOSE 8096

# Bridge the stdio memory-mcp-server to streamable-HTTP/SSE on :8096.
# Note: clients connecting through this bridge see mcp-proxy's own serverInfo
# (name/version), not ours — the proxy terminates the MCP session rather than
# forwarding initialize. Direct stdio clients get {"memory", <package version>}.
# --pass-environment is REQUIRED: mcp-proxy defaults to --no-pass-environment and
# spawns the child with a stripped env, so MEMORY_DB/MEMORY_DATA_DIR would be lost.
# The server would then silently fall back to $HOME/.local/share/memory — a DB
# inside the image layer (lost on restart, invisible to the CLI) — and re-download
# the baked embedding model on every boot.
CMD ["mcp-proxy", "--pass-environment", "--host", "0.0.0.0", "--port", "8096", "--", "memory-mcp-server"]
